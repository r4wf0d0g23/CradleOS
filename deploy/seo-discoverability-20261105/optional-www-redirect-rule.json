{
  "description": "Canonical www.cradleos.io to cradleos.io",
  "expression": "http.host eq \"www.cradleos.io\"",
  "action": "redirect",
  "action_parameters": {
    "from_value": {
      "target_url": {
        "expression": "concat(\"https://cradleos.io\", http.request.uri.path)"
      },
      "status_code": 301,
      "preserve_query_string": true
    }
  },
  "enabled": true
}